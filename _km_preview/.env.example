# ====== Core ======
NODE_ENV=development
APP_NAME="منصة إدارة المعرفة والامتثال — مجموعة الحسني"
NEXT_PUBLIC_APP_NAME="منصة إدارة المعرفة والامتثال"

# ====== Auth ======
# Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret-string-min-32-chars"
JWT_ISSUER="al-hasani-km"
SESSION_TTL_HOURS=8

# ====== Database (PostgreSQL) ======
DATABASE_URL="postgresql://khm:khm_password@localhost:5432/al_hasani_km?schema=public"

# ====== Search (Elasticsearch) ======
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="documents"
# ELASTICSEARCH_API_KEY=

# ====== Vector DB (Qdrant) ======
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="document_chunks"
# QDRANT_API_KEY=

# ====== AI (Anthropic Claude) ======
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"

# ====== Embeddings provider abstraction ======
# يُضبط المزوّد بالكامل من هنا دون تعديل الكود.
# الخيارات: openai | voyage | ollama | gemini | local
EMBEDDINGS_PROVIDER="local"
# بُعد المتجه — يجب أن يطابق مجموعة Qdrant والمزوّد المختار.
# (openai=1536, voyage=1024, ollama/nomic=768). يتركه فارغاً ليأخذ افتراضي المزوّد.
EMBEDDING_DIM=1024
#
# -- OpenAI --
# OPENAI_API_KEY=""
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
#
# -- Voyage AI --
# VOYAGE_API_KEY=""
# VOYAGE_EMBEDDING_MODEL="voyage-3"
#
# -- Ollama (تضمين محلي) --
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ====== Storage (S3 / MinIO) ======
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="documents"
# دلو الفيديو (المرحلة الأولى) ودلو النسخ النصي (المرحلة الثانية)
S3_VIDEO_BUCKET="videos"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ====== OCR ======
# tesseract (local CLI) | azure
OCR_PROVIDER="tesseract"
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=

# ====== Demo mode ======
# When true, screens render from bundled sample data and auth uses seed users
# (no PostgreSQL required). Set false to use the live Prisma data path.
NEXT_PUBLIC_DEMO_MODE=true

# ============================================================================
#  الربط الموحّد مع نظام Home Center (Supabase)
# ============================================================================
# مزوّد المصادقة: local (تجريبي/JWT) | supabase (هوية موحّدة مع النظام الحالي)
AUTH_PROVIDER="local"

# مشروع Supabase نفسه المستخدم في نظام Home Center
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# مفتاح الخدمة — خادمي فقط (للسكربتات وروابط الرفع وإدراج ملفات المستخدمين)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# قاعدة بيانات Supabase (نفس مشروع النظام الحالي)
# المجمّع (pooler) لوقت التشغيل، والمباشر (5432) للهجرات
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-...pooler.supabase.com:5432/postgres"

# دلو تخزين فيديوهات الأكاديمية في Supabase Storage
SUPABASE_VIDEO_BUCKET="academy-videos"

# مفتاح Gemini (يُعاد استخدامه من النظام الحالي) — لمزوّد التضمين gemini
# اضبط أيضاً: EMBEDDINGS_PROVIDER="gemini" و EMBEDDING_DIM=768
GEMINI_API_KEY=""
# GEMINI_EMBEDDING_MODEL="text-embedding-004"

# رابط نظام إدارة المركبات والمعدات الحالي (زر "النظام" في صفحة البوابة).
# اتركه فارغاً ليفتح دخول النظام داخل المنصّة (/login)، أو ضع رابط نظامك الخارجي.
# NEXT_PUBLIC_SYSTEM_URL="https://logistics.alhasani.example"
