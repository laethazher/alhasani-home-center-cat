# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# اختياري — ترحيلات SQL: npm run db:apply-exit-loading | npm run db:apply-exit-clamps
# يُحمَّل أيضاً من .env.local إن وُجد.
# من Supabase → Project Settings → Database → Connection string (URI) مع كلمة مرور قاعدة البيانات
# SUPABASE_DB_URL="postgresql://postgres.[ref]:[PASSWORD]@...pooler.supabase.com:6543/postgres"
#
# بدون CLI: انسخ محتوى supabase/RUN_IN_SQL_EDITOR_exit_clamps.sql إلى SQL Editor في لوحة Supabase ونفّذه.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# Installation Department (isolated data, same or separate project)
# ============================================================
# Optional frontend runtime keys for dedicated installation project.
# If omitted, installation will use the same Supabase project as Tajhiz
# and still remain isolated by installation_* tables.
# VITE_SUPABASE_URL_INSTALLATION="https://your-installation-project.supabase.co"
# VITE_SUPABASE_ANON_KEY_INSTALLATION="your-installation-anon-key"
VITE_SUPABASE_ENABLED_INSTALLATION="true"

# PostgreSQL connection string to apply installation schema/seed.
# Preferred for separate-project mode:
# using scripts:
# - npm run db:installation:apply-schema
# - npm run db:installation:apply-seed
# - npm run db:installation:validate
# SUPABASE_DB_URL_INSTALLATION="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@...pooler.supabase.com:6543/postgres"
#
# Same-project mode: define the existing project DB url once.
# SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@...pooler.supabase.com:6543/postgres"
